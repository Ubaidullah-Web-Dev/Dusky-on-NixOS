# =============================================================================
# Dusky Command Atlas — builtin environment ledger + fzf router
#
#   atlas | cmd_atlas   interactive fuzzy index of the live shell environment
#   The selection is injected into the ZLE buffer with `print -z`.
#
#   Requires zsh 5.9+ and the ISO baseline of fzf >= 0.74.4.
#   External commands: one fzf invocation per selection.
#   Locale: untouched — fzf needs the user's UTF-8 LC_CTYPE to measure the
#   widths of │, ❯, ✔ and the Nerd-Font label glyph correctly.
#
# Register docs ANYWHERE in your zshrc modules with:
#   ZSH_DOCS[<name>]="short description"
#   `+=` below means a re-source never destroys sibling registrations.
# =============================================================================

typeset -gA ZSH_DOCS

ZSH_DOCS+=(
    "l"                   "Standard directory listing."
    "la"                  "Listing including hidden entries."
    "ll"                  "Long listing with permissions and byte sizes."
    "lla"                 "Full long listing including hidden entries."
    "lt"                  "Directory tree view."
    "lt1"                 "Directory tree, 1 level deep."
    "lt2"                 "Directory tree, 2 levels deep."
    "lt3"                 "Directory tree, 3 levels deep."
    "c"                   "Clear terminal display."
    "cls"                 "Clear terminal display."
    "q"                   "Close current shell session."
    "x"                   "Close current shell session."
    "e"                   "Open preferred visual editor ($EDITOR)."
    "v"                   "Open preferred visual editor ($EDITOR)."
    "vi"                  "Open preferred visual editor ($EDITOR)."
    "vim"                 "Open preferred visual editor ($EDITOR)."
    "sv"                  "Open preferred editor with root privileges."
    "untar"               "Extract standard tar.gz archive in place."
    "unzip"               "Extract zip archive in place."
    "extract"             "Universal single-call extractor (tar, zip, 7z, bz2, rar...)."
    "ip"                  "Show network interface IP addresses (brief)."
    "ports"               "Enumerate listening TCP and UDP sockets with owning PIDs."
    "openports"           "Enumerate listening TCP and UDP sockets with owning PIDs."
    "mkcd"                "Create a directory tree and instantly enter it."
    "path"                "Display $PATH entries line by line for inspection."
    "weather"             "Fetch ASCII atmospheric conditions via wttr.in."
    "wttr"                "Fetch ASCII atmospheric conditions via wttr.in."
    "dusky_zram"          "Activate dynamic dynamic ZRAM swap configuration."
    "update_dusky"        "Synchronize with upstream Dusky Linux releases."
    "core"                "System performance and core monitoring."
    "scripts"             "Browse local Dusky helper scripts."
    "mon_info"            "Display detailed monitor configuration."
    "ms"                  "Display detailed monitor configuration."
    "atlas"               "Command and alias interactive reference index."
    "cmd_atlas"           "Command and alias interactive reference index."
    "tree"                "Display directory tree hierarchy."
    "df"                  "Human-readable disk filesystem free space."
    "du"                  "Human-readable file space usage."
    "free"                "Display amount of free and used physical/swap memory."
    "mem"                 "Display formatted memory metrics via free."
    "cat"                 "Concatenate and print files."
    "grep"                "Pattern searching with automatic color highlighting."
    "diff"                "Compare files line by line."
    "top"                 "Process activity monitor."
    "htop"                "Interactive process viewer."
    "btop"                "Resource monitor with hardware graphs."
    "journalctl"          "Query the systemd journal."
)

# -----------------------------------------------------------------------------
# The atlas
# -----------------------------------------------------------------------------
function cmd_atlas() {
    emulate -L zsh
    setopt extendedglob

    if ! zmodload zsh/parameter 2>/dev/null; then
        print -ru2 -- 'atlas: zsh/parameter is unavailable — cannot enumerate the environment.'
        return 1
    fi
    if (( ! $+commands[fzf] )); then
        print -ru2 -- 'atlas: fzf is not installed'
        return 1
    fi

    local -a names kinds rows opts
    local name display desc k choice header
    local -i i width pad=7 hpad=0 rc=0
    local TAB=$'\t' R=$'\e[0m' DIM=$'\e[38;5;242m' BOLD=$'\e[1;37m' TXT=$'\e[38;5;250m'
    local -A col=(
        'Alias' $'\e[38;5;114m'
        'Glob ' $'\e[38;5;174m'
        'Sufx ' $'\e[38;5;180m'
        'Func ' $'\e[38;5;111m'
    )

    # --- ledger: aliases are STRICT (documented entries only) -----------------
    for name in "${(@ok)aliases}"; do
        [[ -n ${ZSH_DOCS[$name]+x} ]] || continue
        names+=( "$name" ); kinds+=( 'Alias' )
    done
    for name in "${(@ok)galiases}"; do
        [[ -n ${ZSH_DOCS[$name]+x} ]] || continue
        names+=( "$name" ); kinds+=( 'Glob ' )
    done
    for name in "${(@ok)saliases}"; do
        [[ -n ${ZSH_DOCS[$name]+x} ]] || continue
        names+=( "$name" ); kinds+=( 'Sufx ' )
    done

    # --- ledger: functions, documented OR public ------------------------------
    for name in "${(@ok)functions}"; do
        if [[ -z ${ZSH_DOCS[$name]+x} ]]; then
            [[ $name == [_.+]* ]] && continue
            [[ $name == (*:zle-*|*zle-*|*-widget|TRAP*|*precmd*|*preexec*|azhw:*|prompt_*) ]] && continue
            [[ $name == (chpwd|periodic|zshaddhistory|zshexit|is-at-least|add-zsh-hook|edit-command-line|compaudit|compdef|compdump|compinit|compinstall) ]] && continue
        fi
        names+=( "$name" ); kinds+=( 'Func ' )
    done

    if (( ! $#names )); then
        print -ru2 -- 'atlas: nothing to display (ZSH_DOCS is empty and no public functions exist).'
        return 1
    fi

    for name in "${names[@]}"; do
        display=${(V)name}
        width=${(m)#display}
        (( width > pad )) && pad=$width
    done
    (( hpad = pad - 7 ))

    # Numeric identities keep names independent of fzf field/line parsing.
    # Preserve each category when an alias and function share a name.
    for (( i=1; i <= $#names; ++i )); do
        name=$names[i]
        display=${(V)name}
        k=$kinds[i]
        desc=${ZSH_DOCS[$name]:-'— no description registered —'}
        desc=${desc//[$'\t\n\r']/ }
        desc=${(V)desc}
        rows+=( "${i}${TAB}${DIM}[${R}${col[$k]}${k}${R}${DIM}]${R}  ${BOLD}${(mr:pad:)display}${R}  ${DIM}│${R}  ${TXT}${desc}${R}" )
    done

    header="   TYPE  COMMAND${(l:hpad:):-}  │  DESCRIPTION"

    opts=(
        --ansi
        --delimiter="$TAB"
        --with-nth=2..
        --accept-nth=1
        --header="$header"
        --layout=reverse
        --inline-info
        --prompt='❯ '
        --pointer='❯'
        --marker='✔ '
        --border=rounded
        --scrollbar='│'
        --style=full
        --ghost='Search commands, aliases, functions...'
        --info=right
        --color="${DUSKY_FZF_COLORS:-bg+:#1e1e2e,bg:#11111b,fg:#cdd6f4}"
    )

    # This picker owns its output protocol; global fzf defaults may enable
    # --multi, --print-query, --expect, or a different record separator.
    choice=$(print -rl -- "${rows[@]}" |
        FZF_DEFAULT_OPTS= FZF_DEFAULT_OPTS_FILE= command fzf "${opts[@]}")
    rc=$?
    case $rc in
        0)      ;;
        1|130)  return 0 ;;                       # no match / aborted
        *)      print -ru2 -- "atlas: fzf exited $rc"
                return $rc ;;
    esac

    if [[ $choice != <1-> ]] || (( choice > $#names )); then
        print -ru2 -- 'atlas: fzf returned an invalid selection.'
        return 1
    fi
    name=$names[choice]
    if [[ $kinds[choice] == 'Func ' ]]; then
        # Functions need one literal command word. Quote alias collisions and
        # reserved words too, so the selected function actually gets invoked.
        if (( $+aliases[$name] || $+galiases[$name] || ${reswords[(Ie)$name]} )); then
            choice=${(qq)name}
        else
            choice=${(q)name}
        fi
    else
        # Quoting an alias token would suppress its expansion.
        choice=$name
    fi
    print -rz -- "$choice"
}

alias atlas='cmd_atlas'
