            "keyWidth": 14,
            "format": "{1}"
        },
        {
            "type": "terminal",
            "key": "\u001b[38;2;178;204;194m \u001b[38;2;191;201;196mterm\u001b[0m",
            "keyWidth": 14,
            "format": "{1}"
        },
        {
            "type": "display",
            "key": "\u001b[38;2;178;204;194m󰹍 \u001b[38;2;191;201;196mdisplay\u001b[0m",
            "keyWidth": 14,
