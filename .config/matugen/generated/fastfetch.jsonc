{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "data",
        "source": "\u001b[38;2;116;218;163m       /\u005c\n\u001b[38;2;116;218;163m      /  \u005c\n\u001b[38;2;145;213;172m     /    \u005c\n\u001b[38;2;145;213;172m    /      \u005c\n\u001b[38;2;130;211;226m   /   ,,   \u005c\n\u001b[38;2;130;211;226m  /   |  |   \u005c\n\u001b[38;2;130;211;226m /_-''    ''-_\u005c\n\n\u001b[38;2;116;218;163m   d u s k y\u001b[0m",
        "padding": {
            "top": 6,
            "right": 3,
            "left": 3
        }
    },
    "display": {
        "separator": " \u001b[38;2;124;149;154m󰇙\u001b[0m ",
        "color": {
            "output": "38;2;215;229;232"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "\u001b[38;2;116;218;163m{user-name}\u001b[0m \u001b[38;2;124;149;154m@\u001b[0m \u001b[38;2;145;213;172m{host-name}\u001b[0m"
        },
        "break",
        {
            "type": "os",
            "key": "\u001b[38;2;116;218;163m \u001b[38;2;177;203;208mos\u001b[0m",
            "keyWidth": 14,
            "format": "{2} {8}"
        },
        {
            "type": "kernel",
            "key": "\u001b[38;2;116;218;163m \u001b[38;2;177;203;208mkernel\u001b[0m",
            "keyWidth": 14,
            "format": "{2}"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;116;218;163m󰦚 \u001b[38;2;177;203;208minstall\u001b[0m",
            "keyWidth": 14,
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "packages",
            "key": "\u001b[38;2;116;218;163m󰏖 \u001b[38;2;177;203;208mpkgs\u001b[0m",
            "keyWidth": 14
        },
        {
            "type": "localip",
            "key": "\u001b[38;2;116;218;163m󰩟 \u001b[38;2;177;203;208mip\u001b[0m",
            "keyWidth": 14,
            "format": "{ipv4}",
            "showPrefixLen": false
        },
        "break",
        {
            "type": "wm",
            "key": "\u001b[38;2;145;213;172m󰈹 \u001b[38;2;177;203;208mwm\u001b[0m",
            "keyWidth": 14,
            "format": "{1} ({3})"
        },
        {
            "type": "shell",
            "key": "\u001b[38;2;145;213;172m󰒉 \u001b[38;2;177;203;208mshell\u001b[0m",
            "keyWidth": 14,
            "format": "{1}"
        },
        {
            "type": "terminal",
            "key": "\u001b[38;2;145;213;172m \u001b[38;2;177;203;208mterm\u001b[0m",
            "keyWidth": 14,
            "format": "{1}"
        },
        {
            "type": "display",
            "key": "\u001b[38;2;145;213;172m󰹍 \u001b[38;2;177;203;208mdisplay\u001b[0m",
            "keyWidth": 14,
            "format": "{4}x{5} @ {3}Hz"
        },
        "break",
        {
            "type": "cpu",
            "key": "\u001b[38;2;130;211;226m󰍛 \u001b[38;2;177;203;208mcpu\u001b[0m",
            "keyWidth": 14,
            "format": "{1}"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;130;211;226m󰆧 \u001b[38;2;177;203;208march\u001b[0m",
            "keyWidth": 14,
            "text": "/lib/ld-linux-x86-64.so.2 --help | awk '/supported, searched/ {print $1; exit}'"
        },
        {
            "type": "gpu",
            "key": "\u001b[38;2;130;211;226m󰢮 \u001b[38;2;177;203;208mgpu\u001b[0m",
            "keyWidth": 14,
            "format": "{2}"
        },
        {
            "type": "memory",
            "key": "\u001b[38;2;130;211;226m󰉿 \u001b[38;2;177;203;208mmemory\u001b[0m",
            "keyWidth": 14,
            "format": "{1} / {2} ({3})"
        },
        {
            "type": "disk",
            "key": "\u001b[38;2;130;211;226m󰉋 \u001b[38;2;177;203;208mdisk\u001b[0m",
            "keyWidth": 14,
            "format": "{1} / {2} ({3}) - {9}",
            "folders": "/"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
