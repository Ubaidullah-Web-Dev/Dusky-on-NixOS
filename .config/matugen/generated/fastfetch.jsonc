        },
        {
            "type": "localip",
            "key": "\u001b[38;2;134;214;190m󰩟 \u001b[38;2;191;201;196mip\u001b[0m",
            "keyWidth": 14,
            "format": "{ipv4}",
            "showPrefixLen": false
        },
        "break",
        {
