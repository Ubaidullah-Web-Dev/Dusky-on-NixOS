{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "data",
        "source": "\u001b[38;2;134;214;190m  \u005c  \u005c //\n\u001b[38;2;134;214;190m ==\u005c__\u005c/ //\n\u001b[38;2;178;204;194m   //   \u005c//\n\u001b[38;2;178;204;194m==//     //==\n\u001b[38;2;169;203;227m //\u005c___//\n\u001b[38;2;169;203;227m// /\u005c  \u005c==\n\u001b[38;2;169;203;227m  // \u005c  \u005c\n\n\u001b[38;2;134;214;190m   d u s k y\u001b[0m",
        "padding": {
            "top": 6,
            "right": 3,
            "left": 3
        }
    },
    "display": {
        "separator": " \u001b[38;2;137;147;142m󰇙\u001b[0m ",
        "color": {
            "output": "38;2;222;228;224"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "\u001b[38;2;134;214;190m{user-name}\u001b[0m \u001b[38;2;137;147;142m@\u001b[0m \u001b[38;2;178;204;194m{host-name}\u001b[0m"
        },
        "break",
        {
            "type": "os",
            "key": "\u001b[38;2;134;214;190m \u001b[38;2;191;201;196mos\u001b[0m",
            "keyWidth": 14,
            "format": "Dusky (NixOS {9})"
        },
        {
            "type": "kernel",
            "key": "\u001b[38;2;134;214;190m \u001b[38;2;191;201;196mkernel\u001b[0m",
            "keyWidth": 14,
            "format": "{2}"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;134;214;190m󰦚 \u001b[38;2;191;201;196minstall\u001b[0m",
            "keyWidth": 14,
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "packages",
            "key": "\u001b[38;2;134;214;190m󰏖 \u001b[38;2;191;201;196mpkgs\u001b[0m",
